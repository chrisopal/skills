{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bid-skills:tender-routing:decision:1.0",
  "title": "Tender routing host decision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "intake_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "catalog_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "lot_structure": {"enum": ["single", "multiple", "unknown"]},
    "lot_structure_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "lots": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/lot"}
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "intake_sha256",
    "catalog_sha256",
    "lot_structure",
    "lot_structure_evidence",
    "lots"
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "quote": {"type": "string", "minLength": 1}
      },
      "required": ["source_id", "location", "quote"]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "construction",
            "hardware_supply",
            "software_integration",
            "service_outsourcing"
          ]
        },
        "rationale": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "required": ["category", "rationale", "evidence"]
    },
    "lot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lot_id": {"type": "string", "minLength": 1},
        "lot_name": {"type": "string", "minLength": 1},
        "mode": {"enum": ["single", "mixed", "unknown"]},
        "components": {
          "type": "array",
          "items": {"$ref": "#/$defs/component"}
        },
        "scenario_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "scenario_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/scenario_evidence"}
        },
        "unknowns": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "required": [
        "lot_id",
        "lot_name",
        "mode",
        "components",
        "scenario_tags",
        "scenario_evidence",
        "unknowns"
      ]
    },
    "scenario_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "required": ["tag", "rationale", "evidence"]
    }
  }
}
