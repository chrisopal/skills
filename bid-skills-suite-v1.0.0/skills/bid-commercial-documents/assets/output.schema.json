{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bid-skills:bid-commercial-documents:output:1.0",
  "title": "商务与资格文件编制输出",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill_id": {
      "const": "bid-commercial-documents"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "blocked",
        "ready"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "revision",
          "relative_path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "forms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "format_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/source"
                      }
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "provided",
                        "missing",
                        "needs_authorization"
                      ]
                    }
                  },
                  "required": [
                    "key",
                    "value",
                    "sources",
                    "state"
                  ],
                  "additionalProperties": false
                }
              },
              "state": {
                "type": "string",
                "enum": [
                  "draft",
                  "accepted"
                ]
              },
              "confirmation_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "section_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "对应08章节ID，禁止无匹配时默认归到最后一章"
              },
              "template_path": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "06原始可编辑Markdown模板相对路径"
              },
              "filled_template_path": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "本次填报Markdown相对路径"
              },
              "table_spec_path": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "本次填报结构JSON相对路径，含paragraphs/tables及来源"
              }
            },
            "required": [
              "id",
              "format_id",
              "title",
              "fields",
              "state",
              "confirmation_ref"
            ],
            "additionalProperties": false
          }
        },
        "signature_tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "form_id": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "string",
                "minLength": 1
              },
              "actor_role": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "type": "string",
                "enum": [
                  "pending",
                  "confirmed"
                ]
              },
              "confirmation_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "form_id",
              "position",
              "actor_role",
              "state",
              "confirmation_ref"
            ],
            "additionalProperties": false
          }
        },
        "commercial_exceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pricing_check": {
          "type": "string",
          "enum": [
            "not_run",
            "passed",
            "failed",
            "not_applicable"
          ]
        }
      },
      "required": [
        "forms",
        "signature_tasks",
        "commercial_exceptions",
        "pricing_check"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "skill_id",
    "project_id",
    "artifact_id",
    "revision",
    "created_at",
    "status",
    "inputs",
    "summary",
    "data",
    "warnings",
    "blockers"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "tender",
            "supplier",
            "official",
            "human_decision",
            "synthetic"
          ]
        }
      },
      "required": [
        "source_id",
        "revision",
        "sha256",
        "location",
        "quote",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
