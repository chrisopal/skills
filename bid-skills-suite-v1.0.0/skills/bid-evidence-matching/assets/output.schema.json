{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bid-skills:bid-evidence-matching:output:1.0",
  "title": "企业素材与证明材料匹配输出",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill_id": {
      "const": "bid-evidence-matching"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "blocked",
        "ready"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "revision",
          "relative_path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "materials": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/source"
                }
              },
              "authorization": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "unknown",
                  "denied"
                ]
              },
              "validity_raw": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "independent_evidence_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "title",
              "subject",
              "revision",
              "sources",
              "authorization",
              "validity_raw"
            ],
            "additionalProperties": false
          }
        },
        "selections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "target_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "material_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "state": {
                "type": "string",
                "enum": [
                  "accepted",
                  "candidate",
                  "rejected",
                  "missing"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "required_count": {
                "type": "integer",
                "minimum": 1
              },
              "independent_count": {
                "type": "integer",
                "minimum": 0
              },
              "confirmation_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "target_ids",
              "material_ids",
              "state",
              "reason",
              "required_count",
              "independent_count",
              "confirmation_ref"
            ],
            "additionalProperties": false
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "materials",
        "selections",
        "gaps"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "skill_id",
    "project_id",
    "artifact_id",
    "revision",
    "created_at",
    "status",
    "inputs",
    "summary",
    "data",
    "warnings",
    "blockers"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "tender",
            "supplier",
            "official",
            "human_decision",
            "synthetic"
          ]
        }
      },
      "required": [
        "source_id",
        "revision",
        "sha256",
        "location",
        "quote",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
