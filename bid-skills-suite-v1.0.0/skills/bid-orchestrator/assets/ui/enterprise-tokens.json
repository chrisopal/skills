    "font-body": "14px",
    "font-label": "13px",
    "font-meta": "12px",
    "font-title": "24px",
    "font-section": "16px",
    "line-body": "1.57",
    "weight-body": "400",
    "weight-emphasis": "600",
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
