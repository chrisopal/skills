{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bid-skills:bid-project-profile:output:1.0",
  "title": "项目画像与场景适配输出",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill_id": {
      "const": "bid-project-profile"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "blocked",
        "ready"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "revision",
          "relative_path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "project_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "buyer": {
          "type": [
            "string",
            "null"
          ]
        },
        "bidder": {
          "type": [
            "string",
            "null"
          ]
        },
        "procurement_profile_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain_pack_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lot_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deadlines": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1
              },
              "raw_value": {
                "type": "string",
                "minLength": 1
              },
              "iso_value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "timezone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/source"
                }
              }
            },
            "required": [
              "event",
              "raw_value",
              "iso_value",
              "timezone",
              "sources"
            ],
            "additionalProperties": false
          }
        },
        "key_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "basis_type": {
                "type": "string",
                "enum": [
                  "explicit",
                  "derived",
                  "proposal",
                  "unknown"
                ]
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/source"
                }
              }
            },
            "required": [
              "key",
              "value",
              "basis_type",
              "sources"
            ],
            "additionalProperties": false
          }
        },
        "applicability_confirmed": {
          "type": "boolean"
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "project_name",
        "buyer",
        "bidder",
        "procurement_profile_id",
        "domain_pack_ids",
        "lot_scope",
        "deadlines",
        "key_facts",
        "applicability_confirmed",
        "unknowns"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "skill_id",
    "project_id",
    "artifact_id",
    "revision",
    "created_at",
    "status",
    "inputs",
    "summary",
    "data",
    "warnings",
    "blockers"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "tender",
            "supplier",
            "official",
            "human_decision",
            "synthetic"
          ]
        }
      },
      "required": [
        "source_id",
        "revision",
        "sha256",
        "location",
        "quote",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
