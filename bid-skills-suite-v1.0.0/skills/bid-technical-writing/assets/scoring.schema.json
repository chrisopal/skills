{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:bid-skills:bid-scoring:output:1.0",
  "title": "评分体系提取与分析输出",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill_id": {
      "const": "bid-scoring"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "blocked",
        "ready"
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "relative_path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "artifact_id",
          "revision",
          "relative_path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "string"
    },
    "data": {
      "type": "object",
      "properties": {
        "declared_total": {
          "type": [
            "number",
            "null"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "parent_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "max_score": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "node_type": {
                "type": "string",
                "enum": [
                  "rollup",
                  "scored"
                ]
              },
              "aggregation": {
                "type": "string",
                "enum": [
                  "sum",
                  "max",
                  "capped",
                  "manual",
                  "none"
                ]
              },
              "rule_text": {
                "type": "string",
                "minLength": 1
              },
              "evidence_requirements": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "sources": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/source"
                }
              }
            },
            "required": [
              "id",
              "parent_id",
              "title",
              "max_score",
              "node_type",
              "aggregation",
              "rule_text",
              "evidence_requirements",
              "sources"
            ],
            "additionalProperties": false
          }
        },
        "arithmetic_findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "declared_total",
        "items",
        "arithmetic_findings",
        "unknowns"
      ],
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "skill_id",
    "project_id",
    "artifact_id",
    "revision",
    "created_at",
    "status",
    "inputs",
    "summary",
    "data",
    "warnings",
    "blockers"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "tender",
            "supplier",
            "official",
            "human_decision",
            "synthetic"
          ]
        }
      },
      "required": [
        "source_id",
        "revision",
        "sha256",
        "location",
        "quote",
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
