{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consulting PPT image content pack 1.0",
  "type": "object",
  "required": [
    "schema_version",
    "deck_id",
    "version",
    "purpose",
    "audience",
    "page_budget",
    "language",
    "theme_profile",
    "story_arc",
    "sections",
    "slides",
    "citation_index"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "deck_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "decisions_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "page_budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "theme_profile": {
      "type": "string",
      "minLength": 1
    },
    "output_formats": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "story_arc": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approval_ref": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "slide_id",
          "order",
          "section",
          "purpose_id",
          "title",
          "key_message",
          "supporting_points",
          "evidence_ids",
          "visual_type",
          "layout_hint",
          "review_status"
        ],
        "properties": {
          "slide_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "section": {
            "type": "string",
            "minLength": 1
          },
          "purpose_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "key_message": {
            "type": "string",
            "minLength": 1
          },
          "supporting_points": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifact_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visual_type": {
            "type": "string",
            "minLength": 1
          },
          "layout_hint": {
            "type": "string"
          },
          "review_status": {
            "enum": [
              "draft",
              "needs_review",
              "approved"
            ]
          },
          "content_complete": {
            "type": "boolean"
          },
          "content_kind": {
            "enum": [
              "source_based",
              "proposal",
              "benchmark",
              "mixed"
            ]
          },
          "visible_qualifier": {
            "type": "string"
          },
          "depends_on_slides": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "protected_terms": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "protected_values": {
            "type": "array"
          },
          "illustrative_values": {
            "type": "array"
          },
          "speaker_notes": {
            "type": "string"
          },
          "story_role": {
            "type": "string"
          },
          "benchmark": {
            "type": "object",
            "required": [
              "entity_id"
            ],
            "properties": {
              "entity_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "diagram_spec": {
            "type": "object",
            "properties": {
              "nodes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "label"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "edges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "from",
                    "to"
                  ],
                  "properties": {
                    "from": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "chart_spec": {
            "type": "object"
          }
        }
      }
    },
    "appendix": {
      "type": "array"
    },
    "citation_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "locator",
          "verification_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "attachment",
              "web",
              "user_instruction",
              "project_plan",
              "official_screenshot"
            ]
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": "string"
          },
          "verification_status": {
            "enum": [
              "provided",
              "verified",
              "unverified"
            ]
          },
          "asset_path": {
            "type": "string"
          },
          "asset_sha256": {
            "type": "string"
          },
          "checked_at": {
            "type": "string"
          }
        }
      }
    },
    "schedule": {
      "type": "object",
      "properties": {
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "date"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "date": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "start",
              "end"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "string",
                "minLength": 1
              },
              "end": {
                "type": "string",
                "minLength": 1
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_finish_before": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
