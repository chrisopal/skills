{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-item.schema.json",
  "title": "Evidence Item",
  "type": "object",
  "required": [
    "evidence_id",
    "project_id",
    "source_type",
    "source_name",
    "claim_or_observation",
    "status"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "source_type": {
      "enum": [
        "document",
        "interview",
        "data",
        "observation",
        "system",
        "external-research"
      ]
    },
    "source_name": {
      "type": "string"
    },
    "source_owner": {
      "type": "string", "minLength": 1
    },
    "source_date": {
      "type": "string", "minLength": 1
    },
    "location": {
      "type": "string", "minLength": 1
    },
    "claim_or_observation": {
      "type": "string"
    },
    "raw_excerpt": {
      "type": "string", "minLength": 1
    },
    "scope": {
      "type": "string", "minLength": 1
    },
    "valid_from": {
      "type": "string"
    },
    "valid_to": {
      "type": "string"
    },
    "confidentiality": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "enum": [
        "unverified",
        "verified",
        "conflicted",
        "superseded"
      ]
    },
    "conflicts_with": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "required": ["reviewer", "checked_at", "method", "result_evidence_ids"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "checked_at": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "result_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "verification_plan": {
      "type": "object",
      "required": ["owner", "due_date", "action"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "due_date": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "verified"}}, "required": ["status"]},
      "then": {"required": ["source_owner", "source_date", "location", "raw_excerpt", "scope", "verification"]}
    },
    {
      "if": {"properties": {"status": {"const": "conflicted"}}, "required": ["status"]},
      "then": {"required": ["conflicts_with", "verification_plan"], "properties": {"conflicts_with": {"minItems": 1}}}
    }
  ],
  "additionalProperties": true
}
