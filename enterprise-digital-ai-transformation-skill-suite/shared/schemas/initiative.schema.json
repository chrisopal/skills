{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "initiative.schema.json",
  "title": "Transformation Initiative",
  "type": "object",
  "required": [
    "initiative_id",
    "name",
    "objective",
    "gap_ids",
    "outcome_kpi_ids",
    "scope",
    "deliverables",
    "dependencies",
    "status"
  ],
  "properties": {
    "initiative_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "gap_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "outcome_kpi_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "deliverables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "business_owner": {
      "type": "string"
    },
    "technology_owner": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cost_estimate": {
      "type": "object"
    },
    "benefit_estimate": {
      "type": "object"
    },
    "risk": {
      "type": "object"
    },
    "target_wave": {
      "type": "string"
    },
    "status": {
      "enum": [
        "candidate",
        "recommended",
        "approved",
        "deferred",
        "rejected",
        "in-progress",
        "completed"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affected_architecture_domains": {
      "type": "array",
      "items": {
        "enum": [
          "BA",
          "IA",
          "AA",
          "TA",
          "cross-cutting"
        ]
      },
      "uniqueItems": true
    },
    "affected_architecture_node_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "target_transition_architecture_id": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
