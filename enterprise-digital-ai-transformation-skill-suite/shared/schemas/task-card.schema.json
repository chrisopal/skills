{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-card.schema.json",
  "title": "Consulting Task Card",
  "type": "object",
  "required": [
    "task_id",
    "project_id",
    "skill_name",
    "skill_version",
    "single_primary_skill",
    "inputs",
    "expected_outputs",
    "acceptance_criteria",
    "gate",
    "review_skill",
    "status"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "skill_name": {"type": "string", "minLength": 1},
    "skill_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "single_primary_skill": {"const": true},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "version", "status", "required"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "status": {
            "enum": ["draft", "assumed", "validated", "approved", "superseded", "rejected"]
          },
          "required": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_type", "target_version"],
        "properties": {
          "artifact_type": {"type": "string", "minLength": 1},
          "target_version": {"type": "string", "minLength": 1},
          "architecture_domains": {
            "type": "array",
            "items": {"enum": ["BA", "IA", "AA", "TA", "cross-cutting", "none"]},
            "uniqueItems": true
          }
        },
        "additionalProperties": true
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "gate": {"type": "string", "pattern": "^G[0-8]$"},
    "review_skill": {"const": "consulting-quality-review"},
    "reviewer_role": {"type": "string"},
    "evidence_policy": {
      "type": "object",
      "properties": {
        "facts_require_evidence": {"const": true},
        "assumptions_require_validation_plan": {"const": true}
      },
      "additionalProperties": false
    },
    "status": {
      "enum": ["ready", "blocked", "in-progress", "completed", "failed"]
    },
    "blocked_reasons": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "blocked"}}},
      "then": {"required": ["blocked_reasons"], "properties": {"blocked_reasons": {"minItems": 1}}}
    }
  ],
  "additionalProperties": true
}
