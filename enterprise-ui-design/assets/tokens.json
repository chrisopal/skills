        "metric": {"family": "@font.role.metric.family", "size": "@font.role.metric.size", "line": "@font.role.metric.line", "weight": "@font.role.metric.weight", "tracking": "0", "numeric": "tabular-nums"},
        "reading": {"family": "@font.role.reading.family", "size": "@font.role.reading.size", "line": "@font.role.reading.line", "weight": "@font.role.reading.weight", "tracking": "0", "numeric": "normal"},
        "nav": {"family": "@font.role.nav.family", "size": "@font.role.nav.size", "line": "@font.role.nav.line", "weight": "@font.role.nav.weight", "tracking": "0", "numeric": "normal"},
        "table-heading": {"family": "@font.role.table-heading.family", "size": "@font.role.table-heading.size", "line": "@font.role.table-heading.line", "weight": "@font.role.table-heading.weight", "tracking": "0", "numeric": "normal"},
        "record": {"family": "@font.role.record.family", "size": "@font.role.record.size", "line": "@font.role.record.line", "weight": "@font.role.record.weight", "tracking": "0", "numeric": "normal"},
        "unit": {"family": "@font.role.unit.family", "size": "@font.role.unit.size", "line": "@font.role.unit.line", "weight": "@font.role.unit.weight", "tracking": "0", "numeric": "tabular-nums"},
        "code": {"family": "@font.role.code.family", "size": "@font.role.code.size", "line": "@font.role.code.line", "weight": "@font.role.code.weight", "tracking": "0", "numeric": "normal"}
      }
    },
    "focus": {
      "ring": "@focus.ring",
      "offset": "@common.focus-offset",
      "style": "solid"
    },
    "z-index": {
      "base": 0,
      "header": "@common.z-header",
      "sidebar": "@common.z-sidebar",
      "popover": "@common.z-popover",
      "dialog": "@common.z-dialog",
      "toast": "@common.z-toast"
    },
    "motion": {
      "fast": "@motion.fast",
      "ease": "@motion.ease",
      "standard": "@common.motion-standard",
      "reduced": "0ms"
    }
  },
  "components": {
    "button": {"height": "@common.density-control-height", "radius": "@common.radius-control", "actionGap": "@common.layout-action-gap", "focus": "@focus.ring"},
    "field": {"height": "@common.density-control-height", "radius": "@common.radius-control", "label": "@font.role.label.size"},
    "panel": {"radius": "@common.radius-panel", "inset": "@common.layout-panel-inset"},
    "dialog": {"radius": "@common.radius-dialog", "zIndex": "@semantics.z-index.dialog"},
    "table": {"cellPaddingBlock": "@common.density-cell-padding-block", "cellPaddingInline": "@common.density-cell-padding-inline", "numberVariant": "@common.font-variant-data"}
  },
  "layout": {
    "page": {"insetInline": "@common.layout-page-inset-inline", "insetBlock": "@common.layout-page-inset-block", "overviewMax": "@common.layout-content-overview-max", "readingMax": "@common.layout-content-reading-max", "formMax": "@common.layout-content-form-max"},
    "section": {"gap": "@common.layout-section-gap"},
    "group": {"gap": "@common.layout-group-gap"},
    "field": {"gap": "@common.layout-field-gap"},
    "action": {"gap": "@common.layout-action-gap"}
  },
  "contrast-pairs": [
    ["text", "surface", 4.5],
    ["text-secondary", "surface", 4.5],
    ["action-text", "surface", 4.5],
    ["on-action", "action-solid", 4.5],
    ["on-inverse", "inverse-surface", 4.5]
  ],
