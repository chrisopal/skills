{
  "meta": {
    "name": "Enterprise Workbench UI",
    "version": "1.3.0",
    "date": "2026-10-21",
    "format": "Project-local CSS value map; keys become --ui-<key>. Not a DTCG interchange schema.",
    "source": "MBC-inspired enterprise style with contrast corrections verified in MateClaw"
  },
  "defaults": {
    "brand": "blue",
    "profile": "enterprise",
    "theme": "light",
    "density": "standard"
  },
