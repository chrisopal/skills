      "unit": "px",
      "roles": {
        "body": {"family": "@font.role.body.family", "size": "@font.role.body.size", "line": "@font.role.body.line", "weight": "@font.role.body.weight", "tracking": "0", "numeric": "normal"},
        "label": {"family": "@font.role.label.family", "size": "@font.role.label.size", "line": "@font.role.label.line", "weight": "@font.role.label.weight", "tracking": "0", "numeric": "normal"},
        "meta": {"family": "@font.role.meta.family", "size": "@font.role.meta.size", "line": "@font.role.meta.line", "weight": "@font.role.meta.weight", "tracking": "0", "numeric": "normal"},
