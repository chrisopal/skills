  "font": {
    "sans": "HarmonyOS Sans, Source Han Sans SC, 思源黑体, Microsoft YaHei, Arial, sans-serif",
    "number": "D-DIN-PRO, DIN, HarmonyOS Sans, Arial, sans-serif",
    "weights": {
      "light": 320,
      "regular": 400,
      "semibold": 600
    },
    "scale": {
      "h1": { "size": 36, "lineHeight": 54, "weight": 600 },
      "h2": { "size": 24, "lineHeight": 36, "weight": 600 },
      "h3": { "size": 20, "lineHeight": 30, "weight": 600 },
      "h4": { "size": 18, "lineHeight": 28, "weight": 600 },
      "h5": { "size": 16, "lineHeight": 24, "weight": 400 },
      "body": { "size": 14, "lineHeight": 22, "weight": 400 },
      "assist": { "size": 12, "lineHeight": 18, "weight": 400 }
    }
  },
  "spacing": [4, 8, 12, 16, 20, 24, 28, 32, 40],
  "radius": {
    "control": 3,
    "card": 6,
    "dropdown": 6,
    "dropdownItem": 3
  },
  "layout": {
    "frontstage": {
      "canvasWidth": 1920,
      "contentWidth": 1128,
      "columns": 12,
      "columnWidth": 72,
      "gutter": 24,
      "gridBase": 8,
      "mobileBreakpoint": 768
    },
    "admin": {
      "canvasWidth": 1440,
      "contentWidth": 1208,
      "columns": 24,
      "gutter": 16,
      "margin": 24,
      "sidebarWidth": 232,
      "supportedWidths": [1366, 1440, 1920]
    }
  },
  "component": {
    "button": {
      "height": 32,
      "paddingY": 5,
      "paddingX": 16,
      "fontSize": 14,
      "radius": 3,
      "icon": 16,
      "iconGap": 8
    },
    "input": {
      "height": 32,
      "paddingY": 5,
      "paddingX": 8,
      "fontSize": 14,
      "radius": 3,
      "icon": 16
    },
    "search": {
      "height": 32,
      "paddingTop": 4,
      "paddingRight": 4,
      "paddingBottom": 4,
      "paddingLeft": 8,
      "fontSize": 14,
      "radius": 3,
      "icon": 24
    },
    "form": {
      "labelFontSize": 14,
      "controlFontSize": 14,
      "labelControlGap": 16,
      "rowGap": 24,
      "labelAlign": "right"
    },
    "card": {
      "paddingY": 16,
      "paddingX": 24,
      "titleFontSize": 16,
      "bodyFontSize": 14,
      "radius": 6,
      "headerHeight": 40
    },
    "tag": {
      "height": 24,
      "paddingY": 2,
      "paddingX": 8,
      "fontSize": 12,
      "icon": 14
    },
    "badge": {
      "height": 20,
      "paddingX": 6,
      "fontSize": 12
    },
    "icon": {
      "common": 16,
      "standard": [24, 48, 72],
      "strokeWidth": 2
    },
    "empty": {
      "titleFontSize": 20,
      "descriptionFontSize": 14,
      "illustrationStyle": "flat"
    },
    "dialog": {
      "paddingY": 16,
      "paddingX": 24,
      "icon": 20,
      "fontSize": 14
    }
  }
}
