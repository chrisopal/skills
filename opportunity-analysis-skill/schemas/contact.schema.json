{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Contact",
  "type": "object",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "account_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "department": {
      "type": [
        "string",
        "null"
      ]
    },
    "role_in_opportunity": {
      "type": [
        "string",
        "null"
      ]
    },
    "responsibility_scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_requirement_owner": {
      "type": "boolean"
    },
    "confirmation_status": {
      "type": [
        "string",
        "null"
      ]
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ]
    },
    "attitude": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
