{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence",
  "type": "object",
  "required": [
    "evidence_id",
    "source_type",
    "source_name",
    "content",
    "confidence",
    "source_refs",
    "requires_human_confirmation"
  ],
  "properties": {
    "evidence_id": {
      "type": "string"
    },
    "source_type": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "file_path": {
      "type": [
        "string",
        "null"
      ]
    },
    "attachments": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "archived_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "evidence_id",
          "archived_path",
          "relative_path",
          "file_name",
          "mime_type",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "evidence_id": {
            "type": "string"
          },
          "original_path": {
            "type": "string"
          },
          "archived_path": {
            "type": "string"
          },
          "relative_path": {
            "type": "string"
          },
          "file_name": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "mime_type": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          },
          "is_image": {
            "type": "boolean"
          }
        }
      }
    },
    "content": {
      "type": "string"
    },
    "extracted_fields": {
      "type": "object"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "requires_human_confirmation": {
      "type": "boolean"
    },
    "parse_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
