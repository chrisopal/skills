{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpportunityAnalysisInput",
  "type": "object",
  "properties": {
    "account_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence_list": {
      "type": "array",
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "analysis_goal": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "sales_confirmation_answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension_id": {
            "type": "string"
          },
          "question_id": {
            "type": "string"
          },
          "answer_text": {
            "type": "string"
          },
          "rating": {
            "type": "string",
            "enum": [
              "strong",
              "medium",
              "weak",
              "unknown",
              "强",
              "中",
              "弱",
              "未知",
              "不确定",
              "待确定",
              "待确认"
            ]
          },
          "answered_by": {
            "type": "string"
          },
          "answered_at": {
            "type": "string"
          }
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "materials"
      ]
    },
    {
      "required": [
        "evidence_list"
      ]
    }
  ]
}
