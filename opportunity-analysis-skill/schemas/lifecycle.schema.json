{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpportunityLifecycle",
  "type": "object",
  "required": [
    "current_stage_id",
    "suggested_stage_id",
    "status",
    "revision",
    "facts",
    "history",
    "actions",
    "artifacts",
    "contracts",
    "reviews"
  ],
  "properties": {
    "current_stage_id": {
      "type": "string"
    },
    "suggested_stage_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "won",
        "lost",
        "cancelled"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "artifact_id",
                "sha256"
              ],
              "properties": {
                "artifact_id": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "additionalProperties": false
            }
          },
          "validity": {
            "enum": [
              "valid",
              "superseded",
              "stale_or_missing",
              "unbound",
              "dependency_invalid"
            ]
          },
          "verification_reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "status_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "next_action": {
      "type": [
        "object",
        "null"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_status": {
      "enum": [
        "current",
        "needs_review"
      ]
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_history": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "requirement_ids",
          "artifact_id",
          "sha256",
          "owner",
          "due_date",
          "blocking",
          "status",
          "evidence",
          "history"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "artifact_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "blocking": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "closure": {
            "type": "object",
            "required": [
              "artifact_id",
              "sha256",
              "resolution",
              "evidence",
              "actor",
              "time"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "resolution": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "time": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "verification_status": {
            "enum": [
              "current",
              "needs_review"
            ]
          },
          "verification_reasons": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "resolved"
                }
              }
            },
            "then": {
              "required": [
                "closure"
              ]
            }
          }
        ]
      }
    }
  }
}
