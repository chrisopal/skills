{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpportunityLifecycleChange",
  "type": "object",
  "required": [
    "request_id",
    "opportunity_id",
    "expected_revision",
    "actor",
    "operations"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "opportunity_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "fact_id",
              "value",
              "evidence"
            ],
            "properties": {
              "type": {
                "const": "confirm_fact"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "fact_id": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "artifact_id": {
                "type": "string",
                "description": "Required for confirmed solution_scope text and positive quote_authorized; binds the exact current solution or quote hash. Explicit unknown scope remains unresolved."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "fact_id": {
                      "const": "solution_scope"
                    },
                    "value": {
                      "type": "string",
                      "not": {
                        "pattern": "^\\s*(?:[Uu][Nn][Kk][Nn][Oo][Ww][Nn]|未知|待确认|不确定|不知道)\\s*$"
                      }
                    }
                  },
                  "required": [
                    "fact_id",
                    "value"
                  ]
                },
                "then": {
                  "required": [
                    "artifact_id"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "fact_id": {
                      "const": "quote_authorized"
                    },
                    "value": {
                      "const": true
                    }
                  },
                  "required": [
                    "fact_id",
                    "value"
                  ]
                },
                "then": {
                  "required": [
                    "artifact_id"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "fact_id": {
                      "const": "solution_scope"
                    }
                  },
                  "required": [
                    "fact_id"
                  ]
                },
                "then": {
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            ]
          },
          {
            "type": "object",
            "required": [
              "type",
              "title",
              "owner",
              "due_date"
            ],
            "properties": {
              "type": {
                "const": "add_action"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "action_id": {
                "type": "string"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "due_date": {
                "type": "string",
                "format": "date"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "action_id",
              "result",
              "evidence"
            ],
            "properties": {
              "type": {
                "const": "complete_action"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "action_id": {
                "type": "string"
              },
              "result": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "kind",
              "version",
              "file_path",
              "evidence"
            ],
            "properties": {
              "type": {
                "const": "register_artifact"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "artifact_id": {
                "type": "string"
              },
              "document_id": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "handoff",
                  "solution",
                  "quote",
                  "negotiation",
                  "contract"
                ]
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "file_path": {
                "type": "string",
                "minLength": 1
              },
              "metadata": {
                "type": "object"
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "artifact_id",
                    "sha256"
                  ],
                  "properties": {
                    "artifact_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "additionalProperties": false
                },
                "description": "Explicit current artifact bindings: quote→solution; negotiation→quote; contract→quote and any existing negotiation; handoff→any existing contract."
              },
              "scope_review": {
                "type": "object",
                "required": [
                  "scope_version",
                  "summary"
                ],
                "properties": {
                  "scope_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "summary": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false,
                "description": "Actual content read-back against the current solution_scope fact version. Required for commercial artifacts and contract-based handoff; not automatic semantic verification."
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "quote",
                        "negotiation",
                        "contract"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "dependencies"
                  ],
                  "properties": {
                    "dependencies": {
                      "minItems": 1
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "quote",
                        "negotiation",
                        "contract"
                      ]
                    }
                  }
                },
                "then": {
                  "required": [
                    "scope_review"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "handoff"
                    },
                    "dependencies": {
                      "type": "array",
                      "minItems": 1
                    }
                  },
                  "required": [
                    "kind",
                    "dependencies"
                  ]
                },
                "then": {
                  "required": [
                    "scope_review"
                  ]
                }
              }
            ]
          },
          {
            "type": "object",
            "required": [
              "type",
              "artifact_id",
              "signing_date",
              "parties",
              "amount",
              "currency",
              "signature_facts",
              "evidence"
            ],
            "properties": {
              "type": {
                "const": "record_contract"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "contract_id": {
                "type": "string"
              },
              "artifact_id": {
                "type": "string"
              },
              "signing_date": {
                "type": "string",
                "format": "date"
              },
              "parties": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "minLength": 1
              },
              "signature_facts": {
                "type": "object",
                "required": [
                  "customer_signed",
                  "supplier_signed"
                ],
                "properties": {
                  "customer_signed": {
                    "const": true
                  },
                  "supplier_signed": {
                    "const": true
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "to_stage",
              "reason",
              "evidence"
            ],
            "properties": {
              "type": {
                "const": "transition"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "to_stage": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "status",
              "reason",
              "evidence"
            ],
            "properties": {
              "type": {
                "const": "set_status"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "status": {
                "enum": [
                  "active",
                  "paused",
                  "lost",
                  "cancelled"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "owner",
              "reason"
            ],
            "properties": {
              "type": {
                "const": "set_owner"
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "competitor_id",
              "name",
              "position",
              "strengths",
              "weaknesses",
              "response",
              "status",
              "evidence"
            ],
            "properties": {
              "type": {
                "const": "record_competitor"
              },
              "competitor_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "position": {
                "type": "string",
                "minLength": 1
              },
              "strengths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "weaknesses": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "response": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "confirmed",
                  "reported",
                  "unknown"
                ]
              },
              "price_amount": {
                "type": "number",
                "minimum": 0
              },
              "currency": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "review_id",
              "title",
              "requirement_ids",
              "artifact_id",
              "owner",
              "due_date",
              "blocking",
              "evidence"
            ],
            "properties": {
              "type": {
                "const": "record_review"
              },
              "review_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "requirement_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "due_date": {
                "type": "string",
                "format": "date"
              },
              "blocking": {
                "type": "boolean"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "review_id",
              "artifact_id",
              "resolution",
              "evidence"
            ],
            "properties": {
              "type": {
                "const": "resolve_review"
              },
              "review_id": {
                "type": "string",
                "minLength": 1
              },
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "resolution": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "review_id",
              "reason",
              "evidence"
            ],
            "properties": {
              "type": {
                "const": "reopen_review"
              },
              "review_id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
