{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpportunityAnalysisOutput",
  "type": "object",
  "required": [
    "human_summary",
    "structured_data",
    "storage_result",
    "display_result"
  ],
  "properties": {
    "human_summary": {
      "type": "string"
    },
    "structured_data": {
      "type": "object",
      "required": [
        "account",
        "contacts",
        "opportunity",
        "risks",
        "next_actions",
        "decision_chain",
        "commercial_assessment",
        "sales_confirmation_questions",
        "evidence",
        "missing_information",
        "evidence_map"
      ],
      "properties": {
        "account": {
          "type": "object"
        },
        "contacts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "opportunity": {
          "type": "object"
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "decision_chain": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "commercial_assessment": {
          "type": "object",
          "required": [
            "win_likelihood_score",
            "deal_attractiveness_score",
            "delivery_confidence_score",
            "overall_opportunity_score",
            "win_probability",
            "confidence_level",
            "dimensions",
            "questions"
          ],
          "properties": {
            "win_likelihood_score": {
              "type": "integer"
            },
            "deal_attractiveness_score": {
              "type": "integer"
            },
            "delivery_confidence_score": {
              "type": "integer"
            },
            "overall_opportunity_score": {
              "type": "integer"
            },
            "win_probability": {
              "type": "number"
            },
            "confidence_level": {
              "type": "string"
            },
            "unanswered_critical_count": {
              "type": "integer"
            },
            "dimensions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "sales_confirmation_questions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sales_confirmation_answers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "missing_information": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_map": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "archived_files": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "storage_result": {
      "type": "object",
      "required": [
        "adapter",
        "saved",
        "account_id",
        "opportunity_id",
        "db_path"
      ],
      "properties": {
        "adapter": {
          "type": "string"
        },
        "saved": {
          "type": "boolean"
        },
        "account_id": {
          "type": "string"
        },
        "opportunity_id": {
          "type": "string"
        },
        "db_path": {
          "type": "string"
        }
      }
    },
    "display_result": {
      "type": "object",
      "required": [
        "template_id"
      ],
      "properties": {
        "template_id": {
          "type": "string"
        },
        "html": {
          "type": "string"
        },
        "markdown": {
          "type": "string"
        },
        "html_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "markdown_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "rendered_view_id": {
          "type": "string"
        }
      }
    },
    "missing_information": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_map": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
