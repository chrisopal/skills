    {"name": "kpi_1_label", "required": true, "max_chars": 24},
    {"name": "kpi_2_value", "required": true, "max_chars": 12},
    {"name": "kpi_2_label", "required": true, "max_chars": 24},
    {"name": "kpi_3_value", "required": false, "max_chars": 12},
    {"name": "kpi_3_label", "required": false, "max_chars": 24},
    {"name": "kpi_4_value", "required": false, "max_chars": 12},
    {"name": "kpi_4_label", "required": false, "max_chars": 24}
  ],
  "layout_regions": {
    "title": {"x": 0.5, "y": 0.4, "w": 12.333, "h": 1.0},
    "content": {"x": 0.5, "y": 1.6, "w": 12.333, "h": 5.0}
