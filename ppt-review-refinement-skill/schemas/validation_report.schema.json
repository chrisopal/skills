{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/ppt-review-refinement/validation_report.schema.json",
  "title": "PPT Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "status",
    "checks",
    "differences",
    "issues",
    "manual_review_required",
    "metrics"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "pass",
        "pass_with_accepted_risks",
        "fail"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "details"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "warning",
              "fail",
              "not_checked"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "differences": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "manual_review_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "object"
    },
    "generated_at": {
      "type": "string"
    },
    "source": {
      "type": "object"
    }
  }
}
